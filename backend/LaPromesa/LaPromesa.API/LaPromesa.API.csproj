<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>lapromesa-erp-api-2026</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaPromesa.DTO\LaPromesa.DTO.csproj" />
    <ProjectReference Include="..\LaPromesa.Negocio\LaPromesa.Negocio.csproj" />
    <ProjectReference Include="..\LaPromesa.Utilidades\LaPromesa.Utilidades.csproj" />
  </ItemGroup>

</Project>
