{
  "info": {
    "_postman_id": "89f4f4f8-dac6-4a01-a132-324c9b882d66",
    "name": "La Promesa ERP - CRUD Proveedores y Compras",
    "description": "CRUD de Proveedores y de Compras (órdenes de compra): Consultar, Agregar, Buscar, Editar y Eliminar. El inicio de sesión es automático (entorno LaPromesa.local). Ejecutar en orden: Agregar crea el registro que usan Buscar, Editar y Eliminar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CRUD Proveedores",
      "item": [
        {
          "name": "1. Consultar proveedores",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/Proveedores/ConsultarProveedores?estado=Activo&ordenarPor=Nombre&direccion=ASC&pagina=1&tamanoPagina=10",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCompras}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"exito = true\", () => pm.expect(pm.response.json().exito).to.eql(true));",
                  "pm.test(\"Trae la lista\", () => pm.expect((pm.response.json().datos || {}).registros).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Agregar proveedor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Proveedores/AgregarProveedor",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Proveedores",
                "AgregarProveedor"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCompras}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Distribuidora Prueba Postman\",\n  \"nit\": \"{{nitNuevo}}\",\n  \"idCategoria\": 1,\n  \"contacto\": \"Ana Prueba\",\n  \"telefono\": \"2360-9999\",\n  \"email\": \"prueba@postman.test\",\n  \"direccion\": \"Zona 1, Cuilapa\",\n  \"departamento\": \"Santa Rosa\",\n  \"tipoPago\": \"Credito\",\n  \"diasCredito\": 30,\n  \"limiteCredito\": 25000,\n  \"banco\": \"Banco Simulado GT\",\n  \"numeroCuenta\": \"SIM-123-4567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function dv(n){let s=0;for(let i=0;i<n.length;i++){s+=(+n[i])*(n.length-i+1);}const r=(11-s%11)%11;return r===10?\"K\":String(r);}",
                  "const cuerpo = String(Math.floor(1000000 + Math.random()*8999999));",
                  "pm.collectionVariables.set(\"nitNuevo\", cuerpo + \"-\" + dv(cuerpo));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"exito = true\", () => pm.expect(pm.response.json().exito).to.eql(true));",
                  "const d = pm.response.json().datos || {};",
                  "pm.collectionVariables.set(\"idProveedorNuevo\", d.idProveedor);",
                  "pm.collectionVariables.set(\"rowVersionProveedor\", d.rowVersion);",
                  "pm.test(\"Código PRxxx asignado\", () => pm.expect(d.codigo).to.match(/^PR\\d{3}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Buscar proveedor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/Proveedores/BuscarProveedor/{{idProveedorNuevo}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCompras}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"idProveedorNuevo\")) pm.collectionVariables.set(\"idProveedorNuevo\", 1);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"exito = true\", () => pm.expect(pm.response.json().exito).to.eql(true));",
                  "pm.test(\"Es el proveedor agregado\", () => pm.expect(((pm.response.json().datos || {}).proveedor || {}).idProveedor).to.eql(Number(pm.collectionVariables.get(\"idProveedorNuevo\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Editar proveedor",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Proveedores/EditarProveedor",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Proveedores",
                "EditarProveedor"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCompras}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Distribuidora Prueba Postman (editada)\",\n  \"nit\": \"{{nitNuevo}}\",\n  \"idCategoria\": 1,\n  \"contacto\": \"Ana Prueba\",\n  \"telefono\": \"2360-9999\",\n  \"email\": \"prueba@postman.test\",\n  \"direccion\": \"Zona 1, Cuilapa\",\n  \"departamento\": \"Santa Rosa\",\n  \"tipoPago\": \"Credito\",\n  \"diasCredito\": 45,\n  \"limiteCredito\": 25000,\n  \"banco\": \"Banco Simulado GT\",\n  \"numeroCuenta\": \"SIM-123-4567890\",\n  \"idProveedor\": {{idProveedorNuevo}},\n  \"rowVersion\": \"{{rowVersionProveedor}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Trae el rowVersion actual del registro antes de editar",
                  "pm.sendRequest({ url: pm.variables.replaceIn(\"{{baseUrl}}/api/Proveedores/BuscarProveedor/{{idProveedorNuevo}}\"), method: \"GET\",",
                  "  header: { Authorization: \"Bearer \" + pm.collectionVariables.get(\"tokenCompras\") } }, (e, r) => {",
                  "  if (!e && r.code === 200) { const d = r.json().datos || {}; const reg = d.proveedor || d.orden || d;",
                  "    if (reg.rowVersion) pm.collectionVariables.set(\"rowVersionProveedor\", reg.rowVersion); }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"exito = true\", () => pm.expect(pm.response.json().exito).to.eql(true));",
                  "const d = pm.response.json().datos || {};",
                  "pm.collectionVariables.set(\"rowVersionViejo\", pm.collectionVariables.get(\"rowVersionProveedor\"));",
                  "pm.collectionVariables.set(\"rowVersionProveedor\", d.rowVersion);",
                  "pm.test(\"Días actualizados\", () => pm.expect(d.diasCredito).to.eql(45));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Eliminar proveedor (inactivación con motivo)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Proveedores/EliminarProveedor/{{idProveedorNuevo}}?motivo=Proveedor de prueba creado desde Postman",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Proveedores",
                "EliminarProveedor",
                "{{idProveedorNuevo}}"
              ],
              "query": [
                {
                  "key": "motivo",
                  "value": "Proveedor de prueba creado desde Postman"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenGerente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"exito = true\", () => pm.expect(pm.response.json().exito).to.eql(true));",
                  "pm.test(\"Queda Inactivo\", () => pm.expect((pm.response.json().datos || {}).estado).to.eql(\"Inactivo\"));"
                ]
              }
            }
          ]
        }
      ]
    },
