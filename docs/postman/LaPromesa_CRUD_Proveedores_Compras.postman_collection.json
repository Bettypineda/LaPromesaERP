  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Inicio de sesión automático según el token que usa cada petición (Compras o Gerente)",
          "const usuarios = { tokenCompras: \"sara.compras\", tokenGerente: \"gerente.general\" };",
          "const auth = pm.request.auth;",
          "const valor = auth && auth.type === \"bearer\" && auth.bearer ? (auth.bearer.get(\"token\") || \"\") : \"\";",
          "const nombre = (valor.match(/\\{\\{(\\w+)\\}\\}/) || [])[1];",
          "if (nombre && usuarios[nombre]) {",
          "  const vence = Number(pm.collectionVariables.get(nombre + \"Vence\") || 0);",
          "  if (!pm.collectionVariables.get(nombre) || Date.now() > vence) {",
          "    pm.sendRequest({",
          "      url: pm.variables.replaceIn(\"{{baseUrl}}\") + \"/api/Autenticacion/IniciarSesion\",",
          "      method: \"POST\",",
          "      header: { \"Content-Type\": \"application/json\" },",
          "      body: { mode: \"raw\", raw: JSON.stringify({ usuario: usuarios[nombre], contrasena: pm.variables.get(\"demoPassword\") }) }",
          "    }, (err, res) => {",
          "      if (err || res.code !== 200) { console.log(\"No se pudo iniciar sesión como \" + usuarios[nombre]); return; }",
          "      const d = res.json().datos || {};",
          "      pm.collectionVariables.set(nombre, d.accessToken);",
          "      pm.collectionVariables.set(nombre + \"Vence\", Date.now() + 14 * 60 * 1000);",
          "    });",
          "  }",
          "}"
        ]
      }
    }
  ]
}