        {
          "name": "2. Agregar orden de compra",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/OrdenesCompra/AgregarOrdenCompra",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "OrdenesCompra",
                "AgregarOrdenCompra"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCompras}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idProveedor\": {{idProveedorOrden}},\n  \"idBodega\": 1,\n  \"fechaEsperada\": \"{{fechaEsperada}}\",\n  \"observaciones\": \"Orden de prueba desde Postman\",\n  \"lineas\": [\n    {\n      \"idProducto\": 1,\n      \"cantidadPedida\": 20,\n      \"costoUnitario\": 4.25\n    },\n    {\n      \"idProducto\": 2,\n      \"cantidadPedida\": 10,\n      \"costoUnitario\": 5.1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); d.setDate(d.getDate() + 5);",
                  "pm.collectionVariables.set(\"fechaEsperada\", d.toISOString().substring(0,10));",
                  "// Usa el proveedor recién agregado si está activo; si no, el primer proveedor activo",
                  "pm.sendRequest({ url: pm.variables.replaceIn(\"{{baseUrl}}/api/Proveedores/ConsultarProveedores?estado=Activo&pagina=1&tamanoPagina=50\"), method: \"GET\",",
                  "  header: { Authorization: \"Bearer \" + pm.collectionVariables.get(\"tokenCompras\") } }, (e, r) => {",
                  "  const lista = (!e && r.code === 200) ? ((r.json().datos || {}).registros || []) : [];",
                  "  const nuevo = Number(pm.collectionVariables.get(\"idProveedorNuevo\"));",
                  "  const elegido = lista.find(p => p.idProveedor === nuevo) || lista[0];",
                  "  if (elegido) pm.collectionVariables.set(\"idProveedorOrden\", elegido.idProveedor);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"exito = true\", () => pm.expect(pm.response.json().exito).to.eql(true));",
                  "const d = pm.response.json().datos || {};",
                  "pm.collectionVariables.set(\"idOrden\", d.idOrdenCompra);",
                  "pm.collectionVariables.set(\"rowVersionOrden\", d.rowVersion);",
                  "pm.test(\"Estado Pendiente\", () => pm.expect(d.estado).to.eql(\"Pendiente\"));",
                  "pm.test(\"Total calculado por la BD (IVA 12%)\", () => pm.expect(d.total).to.eql(Math.round((136.00)*1.12*100)/100));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Buscar orden de compra",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/OrdenesCompra/BuscarOrdenCompra/{{idOrden}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "OrdenesCompra",
                "BuscarOrdenCompra",
                "{{idOrden}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCompras}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"exito = true\", () => pm.expect(pm.response.json().exito).to.eql(true));",
                  "const d = pm.response.json().datos || {};",
                  "pm.test(\"Trae sus líneas\", () => pm.expect((d.lineas || []).length).to.eql(2));",
                  "pm.test(\"Tiene historial\", () => pm.expect((d.historial || []).length).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Editar orden de compra",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/OrdenesCompra/EditarOrdenCompra",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "OrdenesCompra",
                "EditarOrdenCompra"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCompras}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idProveedor\": {{idProveedorOrden}},\n  \"idBodega\": 1,\n  \"fechaEsperada\": \"{{fechaEsperada}}\",\n  \"observaciones\": \"Orden de prueba desde Postman\",\n  \"lineas\": [\n    {\n      \"idProducto\": 1,\n      \"cantidadPedida\": 30,\n      \"costoUnitario\": 4.25\n    },\n    {\n      \"idProducto\": 2,\n      \"cantidadPedida\": 10,\n      \"costoUnitario\": 5.1\n    }\n  ],\n  \"idOrdenCompra\": {{idOrden}},\n  \"rowVersion\": \"{{rowVersionOrden}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Trae el rowVersion actual del registro antes de editar",
                  "pm.sendRequest({ url: pm.variables.replaceIn(\"{{baseUrl}}/api/OrdenesCompra/BuscarOrdenCompra/{{idOrden}}\"), method: \"GET\",",
                  "  header: { Authorization: \"Bearer \" + pm.collectionVariables.get(\"tokenCompras\") } }, (e, r) => {",
                  "  if (!e && r.code === 200) { const d = r.json().datos || {}; const reg = d.proveedor || d.orden || d;",
                  "    if (reg.rowVersion) pm.collectionVariables.set(\"rowVersionOrden\", reg.rowVersion); }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"exito = true\", () => pm.expect(pm.response.json().exito).to.eql(true));",
                  "pm.collectionVariables.set(\"rowVersionOrden\", (pm.response.json().datos || {}).rowVersion);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Eliminar orden de compra (anulación con motivo)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/OrdenesCompra/EliminarOrdenCompra/{{idOrden}}?motivo=Orden de prueba anulada desde Postman",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenGerente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"exito = true\", () => pm.expect(pm.response.json().exito).to.eql(true));",
                  "pm.test(\"Estado Anulada\", () => pm.expect((pm.response.json().datos || {}).estado).to.eql(\"Anulada\"));"
                ]
              }
            }
          ]
        }
      ]
    }
